# Byte-compiled Python files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and local configuration
.env
.env.*
!.env.example

# Test, coverage, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# IDE and editor files
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.vscode/
*.swp
*.swo

# Runtime output and local data
logs/*
!logs/.gitkeep
*.log
*.db
*.sqlite
*.sqlite3

# OS metadata
.DS_Store
Thumbs.db

